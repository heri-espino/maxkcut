\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{maxcut-appendix}[2026/11/26 Max-Cut numerical appendix design]
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath}
\RequirePackage{stix2}
\RequirePackage{microtype}
\RequirePackage[a4paper,left=22mm,right=22mm,top=23mm,bottom=23mm,headheight=15pt,headsep=8mm]{geometry}
\RequirePackage{graphicx,booktabs,tabularx,array,caption,float,xcolor,fancyhdr,hyperref}
\definecolor{ink}{HTML}{182A3A}
\definecolor{muted}{HTML}{536575}
\definecolor{ruleblue}{HTML}{B5C5CF}
\hypersetup{colorlinks=true,linkcolor=ink,urlcolor=ink}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily\color{muted} MAX-CUT \enspace / \enspace NUMERICAL APPENDIX}
\fancyhead[R]{\small\sffamily\color{muted} EXPERIMENT \ExperimentNumber}
\fancyfoot[L]{\small\color{muted} \AppendixFooter}
\fancyfoot[R]{\small\color{muted}\thepage}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt}
\setlength{\abovecaptionskip}{6pt}
\setlength{\belowcaptionskip}{0pt}
\setlength{\intextsep}{8pt plus 2pt}
\setlength{\textfloatsep}{10pt plus 2pt}
\captionsetup{font=small,labelfont={bf,color=ink},textfont=normalfont,format=plain,justification=raggedright,singlelinecheck=false}
\setlength{\emergencystretch}{2em}
\raggedbottom
\newcommand{\appendixheading}[3]{%
  {\color{muted}\small\sffamily\bfseries #1\par}\vspace{3pt}%
  {\color{ink}\LARGE\bfseries #2\par}\vspace{5pt}%
  {\color{muted}\normalsize #3\par}\vspace{7pt}%
  {\color{ruleblue}\hrule height .6pt}\vspace{8pt}}
\newcommand{\resultfigure}[4][.31\textheight]{%
  \begin{figure}[H]\centering
  \includegraphics[width=\linewidth,height=#1,keepaspectratio]{figures/#2.pdf}%
  \caption{#3}\label{fig:#2}\end{figure}%
  \if\relax\detokenize{#4}\relax\else{\small\textbf{Interpretation.} #4\par}\fi}
\newcommand{\sectionpage}[1]{\clearpage\section{#1}}
\renewcommand{\arraystretch}{1.13}
